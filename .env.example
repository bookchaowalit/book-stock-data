# Free-only defaults for book-stock-data
# Copy to .env locally if needed. Never commit real secrets.

FREE_ONLY=true
ALLOW_PAID_PROVIDERS=false
ALLOW_EXTERNAL_WRITES=false
API_HOST=127.0.0.1
API_PORT=8102
ALLOW_REFRESH=false
# REFRESH_TOKEN=  # only if you intentionally enable local refresh
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=2
STALE_AFTER_HOURS=24

# Optional credentials are NEVER required for free defaults.
# Leave unset. Do not put real keys here.
# FIRECRAWL_API_KEY=
# TEQUILA_API_KEY=
# BRAVE_API_KEY=
# COINGECKO_PRO_API_KEY=
